# Copy to .env and fill in. Never commit .env.

# Required
OPENAI_API_KEY=sk-your-key-here
# Local Redis: redis://localhost:6379
# Redis Cloud: redis://default:password@host:port
REDIS_URL=redis://localhost:6379

# Required for the event log: a long random secret used to pseudonymise learners.
# Generate once (python -c "import secrets; print(secrets.token_hex(32))") and never change
# it; back it up with .env, or old and new pseudonyms stop matching. Without it the event
# log is off.
LEA_EVENT_SALT=
# Optional: where the event log lives (default: data/lea_events.db)
# LEA_EVENTS_DB=

# Optional: YouTube Data API key for worked-example video suggestions in Tutor mode
YOUTUBE_API_KEY=

# Optional: root folder for linked (read-only) course materials, one subfolder per course
# code. A Build job ingests a linked folder's files alongside any uploads -- see the Teacher
# area's "Linked materials" card. Default: ~/Documents/LEA/course_materials
# LEA_COURSE_MATERIALS_ROOT=

# Logging: DEBUG shows the detailed trace; INFO (default) keeps the console quiet.
LOG_LEVEL=INFO
